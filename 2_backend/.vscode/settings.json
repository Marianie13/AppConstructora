{
  // Hace que la extension de Java relea el pom.xml automaticamente
  // cuando cambia, sin tener que importarlo a mano.
  "java.configuration.updateBuildConfiguration": "automatic",

  // Lombok genera los getters y setters al compilar. Sin esto, el editor
  // avisa de campos "no usados" que si se usan.
  "java.compile.nullAnalysis.mode": "disabled",

  // Evita que resalte las tildes y la enie como caracteres sospechosos.
  "editor.unicodeHighlight.ambiguousCharacters": false,
  "editor.unicodeHighlight.nonBasicASCII": false,

  // Comodidad al leer el codigo en pantalla o al grabar.
  "editor.minimap.enabled": false,
  "editor.fontSize": 14,
  "files.exclude": {
    "**/target": true
  }
}
